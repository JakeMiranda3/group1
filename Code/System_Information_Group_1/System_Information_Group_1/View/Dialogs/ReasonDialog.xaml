<Window x:Class="System_Information_Group_1.View.Dialogs.ReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:System_Information_Group_1.View.Dialogs"
        mc:Ignorable="d"
        Title="ReasonDialog" Height="250" Width="800"
        ResizeMode="NoResize">
    <StackPanel Margin="20">

        <TextBlock Text="Reason for appointment:"
                   FontSize="16"
                   Margin="0,0,0,10"/>

        <TextBox x:Name="reasonTextBox"
                 Height="100"
                 MaxLength="256"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Width="756"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button x:Name="cancelButton" Content="Cancel"
                    Width="80"
                    Margin="0,0,10,0" Click="cancelButton_Click"
                    />

            <Button x:Name="confirmButton" Content="Confirm"
                    Width="80" Click="confirmButton_Click"
                    />

        </StackPanel>

    </StackPanel>
</Window>
