<Window x:Class="System_Information_Group_1.View.Dialogs.ReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:System_Information_Group_1.View.Dialogs"
        mc:Ignorable="d"
        Title="ReasonDialog" Height="300" Width="800"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">

        <TextBlock Text="Reason for appointment:"
                   FontSize="16"
                   Margin="0,0,0,10"/>

        <TextBox x:Name="reasonTextBox"
                 Height="100"
                 MaxLength="100"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>

        <Grid Margin="0,15,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="errorMessage"
                       Grid.Column="0"
                       Foreground="DarkRed"
                       FontSize="14"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Visibility="Collapsed"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="cancelButton"
                        Content="Cancel"
                        Width="80"
                        Margin="0,0,10,0"
                        Click="cancelButton_Click"/>

                <Button x:Name="confirmButton"
                        Content="Confirm"
                        Width="80"
                        Click="confirmButton_Click"/>

            </StackPanel>

        </Grid>

    </StackPanel>
</Window>
