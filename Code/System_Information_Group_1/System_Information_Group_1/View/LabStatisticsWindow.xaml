<Window x:Class="System_Information_Group_1.View.LabStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:barUserControl="clr-namespace:System_Information_Group_1.View.UserControls"
        mc:Ignorable="d"
        Title="Lab Statistics"
        MinHeight="720"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Width="1539">

    <Grid Background="{StaticResource PrimaryBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                BorderThickness="0,0,0,2"
                BorderBrush="{StaticResource OutlineBrush}">
            <barUserControl:TopAppBar BarHeader="Lab Statistics"/>
        </Border>

        <Grid Grid.Row="1"
              Grid.Column="0"
              Margin="15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Test Statistics"
                       FontSize="20"
                       Margin="0,0,0,15"/>

            <DataGrid x:Name="statisticsDataGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ItemsSource="{Binding Statistics}">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Test Code"
                        Binding="{Binding TestCode}"
                        Width="100"/>

                    <DataGridTextColumn
                        Header="Test Name"
                        Binding="{Binding Name}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Times Performed"
                        Binding="{Binding SpecificTestCount}"
                        Width="130"/>

                    <DataGridTextColumn
                        Header="Total Tests Performed"
                        Binding="{Binding TotalTests}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Performed Percentage (%)"
                        Binding="{Binding Percent, StringFormat={}{0:F2}%}"
                        Width="180"/>

                    <DataGridTextColumn
                        Header="Normal Results Total"
                        Binding="{Binding NormalCount}"
                        Width="135"/>

                    <DataGridTextColumn
                        Header="Abnormal Results Total"
                        Binding="{Binding AbnormalCount}"
                        Width="145"/>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>


        <Border Grid.Row="1"
                Grid.Column="1"
                BorderThickness="2,0,0,0"
                BorderBrush="{StaticResource OutlineBrush}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <Border Grid.Row="0"
                        BorderThickness="0,0,0,2"
                        BorderBrush="{StaticResource OutlineBrush}">
                    <TextBlock Text="Statistics Navigation"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Margin="15,0"/>
                </Border>


                <StackPanel Grid.Row="1"
                            Margin="15,20,15,10">

                    <TextBlock Text="Start Date"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <DatePicker x:Name="startDatePicker"
                                Height="35"
                                HorizontalAlignment="Stretch"/>
                </StackPanel>


                <StackPanel Grid.Row="2"
                            Margin="15,10,15,20">

                    <TextBlock Text="End Date"
                               FontSize="14"
                               Margin="0,0,0,8"/>

                    <DatePicker x:Name="endDatePicker"
                                Height="35"
                                HorizontalAlignment="Stretch"/>
                </StackPanel>


                <Border Grid.Row="3"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource OutlineBrush}"/>

                <Button x:Name="generateStatisticsButton"
                        Grid.Row="4"
                        Content="Generate Statistics"
                        Height="40"
                        Margin="15,20,15,15"
                        Style="{StaticResource BlueButtonStyle}" Click="generateStatisticsButton_Click"/>

                <Button x:Name="exitButton"
                        Grid.Row="6"
                        Content="Exit Statistics"
                        Height="40"
                        Margin="15,15,15,20"
                        Background="{StaticResource CancelColorBrush}"
                        Style="{StaticResource BlueButtonStyle}" FontSize="16" Click="exitButton_Click"/>

            </Grid>
        </Border>
    </Grid>
</Window>