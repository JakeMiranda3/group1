<Window x:Class="System_Information_Group_1.View.LabStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:System_Information_Group_1.View"
        xmlns:userControls="clr-namespace:System_Information_Group_1.View.UserControls"
        mc:Ignorable="d"
        Title="LabStatisticsWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2" BorderThickness="0,0,0,2" BorderBrush="{StaticResource OutlineBrush}">

            <userControls:TopAppBar BarHeader="Appointment Schedules"/>
        </Border>
    </Grid>
</Window>
