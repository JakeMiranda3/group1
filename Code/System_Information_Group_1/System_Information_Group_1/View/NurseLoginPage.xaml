<Page x:Class="System_Information_Group_1.View.NurseLoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:System_Information_Group_1.View"
      mc:Ignorable="d" d:DesignWidth="650"
      Title="NurseLoginPage" Background="WhiteSmoke" Height="234">

    <Grid Background="White" Margin="121,39,116,23">
        <TextBlock HorizontalAlignment="Left" Margin="63,43,0,0" TextWrapping="Wrap" Text="Username" VerticalAlignment="Top" FontFamily="Arial Black" Foreground="#FF005AFF"/>
        <TextBlock HorizontalAlignment="Left" Margin="63,123,0,0" TextWrapping="Wrap" Text="Password" VerticalAlignment="Top" FontFamily="Arial Black" Foreground="#FF005AFF"/>
        <TextBox x:Name="NurseUsernameTextBox" HorizontalAlignment="Left" Margin="175,43,0,0" TextWrapping="Wrap" Text="John" VerticalAlignment="Top" Width="120" Foreground="#FF8C9495"/>
        <TextBox x:Name="NursePasswordTextBox" HorizontalAlignment="Left" Margin="175,123,0,0" TextWrapping="Wrap" Text="Doe" VerticalAlignment="Top" Width="120" Foreground="#FF8C9495"/>

    </Grid>
</Page>
