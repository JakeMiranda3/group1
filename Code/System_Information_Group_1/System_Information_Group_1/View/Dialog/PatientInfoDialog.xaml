<Window x:Class="System_Information_Group_1.View.Dialog.PatientInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient Information"
        Height="600"
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="LightBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="65" />
            <RowDefinition Height="*" />
            <RowDefinition Height="65" />
        </Grid.RowDefinitions>

        <Border Background="White"
                BorderBrush="Black"
                BorderThickness="0,0,0,2">
            <TextBlock Text="Patient Information"
                       FontSize="24"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0" />
        </Border>

        <Grid Grid.Row="1" Margin="25,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>

                <Style x:Key="PatientTextBoxStyle" TargetType="TextBox">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="IsReadOnly" Value="True" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />

                    <Style.Triggers>
                        <Trigger Property="IsReadOnly" Value="False">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="5,0" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>

            <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="0,0,0,1" />
            <Border Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1" />
            <Border Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1" />
            <Border Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1" />
            <Border Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1" />
            <Border Grid.Row="5" Grid.ColumnSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1" />
            <Border Grid.Row="6" Grid.ColumnSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1" />
            <Border Grid.Row="7" Grid.ColumnSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1" />
            <Border Grid.Row="8" Grid.ColumnSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1" />
            <Border Grid.Row="9" Grid.ColumnSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1" />
            <Border Grid.Row="10" Grid.ColumnSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1" />
            <Border Grid.Row="11" Grid.ColumnSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1" />


            <TextBlock Grid.Row="0" Grid.Column="0" Text="Patient ID:" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding PatientId}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Person ID:" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding PersonId}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="First Name:" />
            <TextBox x:Name="firstNameTextBox"
                     Grid.Row="2" Grid.Column="1"
                     Text="{Binding Person.FirstName, Mode=OneWay}"
                     Style="{StaticResource PatientTextBoxStyle}"
                     MaxLength="20" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Name:" />
            <TextBox x:Name="lastNameTextBox"
                     Grid.Row="3" Grid.Column="1"
                     Text="{Binding Person.LastName, Mode=OneWay}"
                     Style="{StaticResource PatientTextBoxStyle}"
                     MaxLength="20" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Date of Birth:" />
            <TextBlock x:Name="dateOfBirthTextBlock"
                       Grid.Row="4" Grid.Column="1"
                       Text="{Binding Person.DateOfBirth, StringFormat=d}" />

            <DatePicker x:Name="dateOfBirthPicker"
                        Grid.Row="4" Grid.Column="1"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Phone Number:" />
            <TextBox x:Name="phoneNumberTextBox"
                     Grid.Row="5" Grid.Column="1"
                     Text="{Binding Person.ContactPhoneNumber, Mode=OneWay}"
                     Style="{StaticResource PatientTextBoxStyle}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Address:" />
            <TextBox x:Name="addressTextBox"
                     Grid.Row="6" Grid.Column="1"
                     Text="{Binding Person.Address, Mode=OneWay}"
                     Style="{StaticResource PatientTextBoxStyle}"
                     MaxLength="20" />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="City:" />
            <TextBox x:Name="cityTextBox"
                     Grid.Row="7" Grid.Column="1"
                     Text="{Binding Person.City, Mode=OneWay}"
                     Style="{StaticResource PatientTextBoxStyle}"
                     MaxLength="20" />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="State:" />
            <TextBlock x:Name="stateTextBlock"
                       Grid.Row="8" Grid.Column="1"
                       Text="{Binding Person.State}" />

            <ComboBox x:Name="stateComboBox"
                      Grid.Row="8" Grid.Column="1"
                      Visibility="Collapsed"
                      VerticalAlignment="Center" />

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Gender:" />
            <TextBlock x:Name="genderTextBlock"
                       Grid.Row="9" Grid.Column="1"
                       Text="{Binding Person.Gender}" />

            <ComboBox x:Name="genderComboBox"
                      Grid.Row="9" Grid.Column="1"
                      Visibility="Collapsed"
                      VerticalAlignment="Center" />

            <TextBlock Grid.Row="10" Grid.Column="0" Text="ZIP Code:" />
            <TextBox x:Name="zipTextBox"
                     Grid.Row="10" Grid.Column="1"
                     Text="{Binding Person.Zip, Mode=OneWay}"
                     Style="{StaticResource PatientTextBoxStyle}"
                     MaxLength="9" />

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Active:" />
            <CheckBox x:Name="isActiveCheckBox"
                      Grid.Row="11" Grid.Column="1"
                      IsChecked="{Binding IsActive, Mode=OneWay}"
                      IsHitTestVisible="False"
                      Focusable="False"
                      VerticalAlignment="Center" />

        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="Black"
                BorderThickness="0,2,0,0"
                Padding="12">


            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="editPatientButton"
                        Content="Edit Patient"
                        Width="130"
                        Height="38"
                        Margin="0,0,15,0"
                        Style="{StaticResource BlueButtonStyle}"
                        Background="#FFF1F1F1"
                        Click="EditPatientButton_OnClick" />

                <Button x:Name="saveChangesButton"
                        Content="Save Changes"
                        Width="130"
                        Height="38"
                        Margin="0,0,15,0"
                        Visibility="Collapsed"
                        Style="{StaticResource BlueButtonStyle}"
                        Background="#FFF1F1F1"
                        Click="SaveChangesButton_OnClick" />

                <Button x:Name="cancelEditButton"
                        Content="Cancel"
                        Width="110"
                        Height="38"
                        Visibility="Collapsed"
                        Style="{StaticResource BlueButtonStyle}"
                        Background="#FFF1F1F1"
                        Click="CancelEditButton_OnClick" />

                <Button x:Name="closeButton"
                        Content="Close"
                        Width="110"
                        Height="38"
                        Style="{StaticResource BlueButtonStyle}"
                        Background="#FFF1F1F1"
                        IsCancel="True" />

            </StackPanel>

        </Border>
    </Grid>
</Window>