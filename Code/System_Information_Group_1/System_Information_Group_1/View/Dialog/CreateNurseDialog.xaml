<Window x:Class="System_Information_Group_1.View.Dialog.CreateNurseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Nurse"
        Height="600"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="LightBlue">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Create Nurse"
                   FontSize="24"
                   Margin="0,0,0,20" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="First Name:" />
            <TextBox x:Name="firstNameTextBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     Height="30"
                     Margin="0,0,0,10" />

            <Label Grid.Row="1" Grid.Column="0" Content="Last Name:" />
            <TextBox x:Name="lastNameTextBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Height="30"
                     Margin="0,0,0,10" />

            <Label Grid.Row="2" Grid.Column="0" Content="Date of Birth:" />
            <DatePicker x:Name="dateOfBirthPicker"
                        Grid.Row="2"
                        Grid.Column="1"
                        Height="30"
                        Margin="0,0,0,10" />

            <Label Grid.Row="3" Grid.Column="0" Content="Phone Number:" />
            <TextBox x:Name="phoneNumberTextBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Height="30"
                     Margin="0,0,0,10" />

            <Label Grid.Row="4" Grid.Column="0" Content="Address:" />
            <TextBox x:Name="addressTextBox"
                     Grid.Row="4"
                     Grid.Column="1"
                     Height="30"
                     Margin="0,0,0,10" />

            <Label Grid.Row="5" Grid.Column="0" Content="Zip Code:" />
            <TextBox x:Name="zipTextBox"
                     Grid.Row="5"
                     Grid.Column="1"
                     Height="30"
                     Margin="0,0,0,10" />

            <Label Grid.Row="6" Grid.Column="0" Content="City:" />
            <TextBox x:Name="cityTextBox"
                     Grid.Row="6"
                     Grid.Column="1"
                     Height="30"
                     Margin="0,0,0,10" />

            <Label Grid.Row="7" Grid.Column="0" Content="State:" />
            <TextBox x:Name="stateTextBox"
                     Grid.Row="7"
                     Grid.Column="1"
                     Height="30"
                     Margin="0,0,0,10" />

            <Label Grid.Row="8" Grid.Column="0" Content="Gender:" />
            <TextBox x:Name="genderTextBox"
                     Grid.Row="8"
                     Grid.Column="1"
                     Height="30" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button x:Name="registerButton"
                    Content="Register Nurse"
                    Width="130"
                    Height="35"
                    Margin="0,0,10,0"
                    Style="{StaticResource BlueButtonStyle}"
                    Click="RegisterButton_OnClick" />

            <Button x:Name="cancelButton"
                    Content="Cancel"
                    Width="100"
                    Height="35"
                    Click="CancelButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>