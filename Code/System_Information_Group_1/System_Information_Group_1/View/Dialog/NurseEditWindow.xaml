<Window x:Class="System_Information_Group_1.View.NurseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Nurse" Height="460" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="LightBlue">
    <Grid Margin="10" Background="LightBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
            
            <RowDefinition Height="Auto"/>
            
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">First name:</TextBlock>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FirstName}" Margin="4"/>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Last name:</TextBlock>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LastName}" Margin="4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Date of birth:</TextBlock>
        <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding DateOfBirth}" Margin="4"/>

        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">Gender:</TextBlock>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Gender}" Margin="4"/>

        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">Phone:</TextBlock>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PhoneNumber}" Margin="4"/>

        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0">Address:</TextBlock>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Address}" Margin="4,1,4,3" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center">Zip:</TextBlock>
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Zip}" Margin="4"/>

        <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center">City:</TextBlock>
        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding City}" Margin="4"/>

        <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center">State:</TextBlock>
        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding State}" Margin="4"/>

        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="80" Margin="4" IsDefault="True" Click="OkButton_Click">OK</Button>
            <Button Width="80" Margin="4" IsCancel="True" Click="CancelButton_Click">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>