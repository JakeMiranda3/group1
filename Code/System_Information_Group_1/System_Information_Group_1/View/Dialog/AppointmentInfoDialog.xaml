<Window x:Class="System_Information_Group_1.View.Dialog.AppointmentInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Appointment Information"
        Height="500"
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="{StaticResource PrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="65" />
            <RowDefinition Height="*" />
            <RowDefinition Height="65" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource OutlineBrush}"
                BorderThickness="0,0,0,2">
            <TextBlock Text="Appointment Information"
                       FontSize="24"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0" />
        </Border>

        <Grid Grid.Row="1" Margin="25,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="100" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>

                <Style x:Key="AppointmentTextBoxStyle"
                       TargetType="TextBox">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Center" />
                    <Setter Property="IsReadOnly" Value="True" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />

                    <Style.Triggers>
                        <Trigger Property="IsReadOnly" Value="False">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="5,0" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>

            <Border Grid.Row="0" Grid.ColumnSpan="2"
                    BorderBrush="{StaticResource OutlineBrush}"
                    BorderThickness="0,0,0,1" />

            <Border Grid.Row="1" Grid.ColumnSpan="2"
                    BorderBrush="{StaticResource OutlineBrush}"
                    BorderThickness="0,0,0,1" />

            <Border Grid.Row="2" Grid.ColumnSpan="2"
                    BorderBrush="{StaticResource OutlineBrush}"
                    BorderThickness="0,0,0,1" />

            <Border Grid.Row="3" Grid.ColumnSpan="2"
                    BorderBrush="{StaticResource OutlineBrush}"
                    BorderThickness="0,0,0,1" />

            <Border Grid.Row="4" Grid.ColumnSpan="2"
                    BorderBrush="{StaticResource OutlineBrush}"
                    BorderThickness="0,0,0,1" />

            <Border Grid.Row="5" Grid.ColumnSpan="2"
                    BorderBrush="{StaticResource OutlineBrush}"
                    BorderThickness="0,0,0,1" />

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Appointment ID:" />

            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding AppointmentId}" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Doctor Name:" />

            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="doctorNameTextBlock">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} {1}">
                        <MultiBinding.Bindings>
                            <Binding Path="Doctor.Person.FirstName" />
                            <Binding Path="Doctor.Person.LastName" />
                        </MultiBinding.Bindings>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <ComboBox x:Name="doctorComboBox"
                      Grid.Row="1"
                      Grid.Column="1"
                      Visibility="Collapsed"
                      VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="Person.FirstName" />
                                    <Binding Path="Person.LastName" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="Patient Name:" />

            <TextBlock Grid.Row="2" Grid.Column="1">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} {1}">
                        <MultiBinding.Bindings>
                            <Binding Path="Patient.Person.FirstName" />
                            <Binding Path="Patient.Person.LastName" />
                        </MultiBinding.Bindings>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="Reason:"
                       VerticalAlignment="Top"
                       Margin="0,6,0,0" />

            <TextBox x:Name="reasonTextBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Text="{Binding Reason, Mode=OneWay}"
                     Style="{StaticResource AppointmentTextBoxStyle}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,5,0,5" />

            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="Date:" />

            <TextBlock x:Name="appointmentDateTextBlock"
                       Grid.Row="4"
                       Grid.Column="1"
                       Text="{Binding Date, StringFormat={}{0:MM/dd/yyyy}}" />

            <DatePicker x:Name="appointmentDatePicker"
                        Grid.Row="4"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />

            <TextBlock Grid.Row="5"
                       Grid.Column="0"
                       Text="Time:" />

            <TextBlock x:Name="appointmentTimeTextBlock"
                       Grid.Row="5"
                       Grid.Column="1"
                       Text="{Binding Date, StringFormat={}{0:hh:mm tt}}" />

            <ComboBox x:Name="appointmentTimeComboBox"
                      Grid.Row="5"
                      Grid.Column="1"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      FontSize="16"
                      IsEditable="False" />

        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource OutlineBrush}"
                BorderThickness="0,2,0,0"
                Padding="12">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button
                        x:Name="deleteAppointmentButton"
                        Content="Delete Appointment"
                        Width="140"
                        Height="38"
                        Margin="0,0,100,0"
                        Style="{StaticResource BlueButtonStyle}" Click="deleteAppointmentButton_Click">
                    <Button.Background>
                        <SolidColorBrush Color="{DynamicResource CancelColor}"/>
                    </Button.Background>
                </Button>
                <Button x:Name="editAppointmentButton"
                        Content="Edit Appointment"
                        Width="140"
                        Height="38"
                        Margin="0,0,15,0"
                        Style="{StaticResource BlueButtonStyle}"
                        Click="EditAppointmentButton_OnClick" />

                <Button x:Name="saveChangesButton"
                        Content="Save Changes"
                        Width="130"
                        Height="38"
                        Margin="0,0,15,0"
                        Visibility="Collapsed"
                        Style="{StaticResource BlueButtonStyle}"
                        Click="SaveChangesButton_OnClick" />

                <Button x:Name="cancelEditButton"
                        Content="Cancel"
                        Width="110"
                        Height="38"
                        Visibility="Collapsed"
                        Style="{StaticResource BlueButtonStyle}"
                        Click="CancelEditButton_OnClick" />

                <Button x:Name="closeButton"
                        Content="Close"
                        Width="110"
                        Height="38"
                        Style="{StaticResource BlueButtonStyle}"
                        IsCancel="True" />

            </StackPanel>

        </Border>
    </Grid>
</Window>
