<Window x:Class="System_Information_Group_1.View.PatientAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:System_Information_Group_1.View"
        xmlns:barUserControl="clr-namespace:System_Information_Group_1.View.UserControls"
        xmlns:scheduleUserControl="clr-namespace:System_Information_Group_1.View.UserControls"

        mc:Ignorable="d"
        Title="Create Appointment" MinHeight="720" MinWidth="1280" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70*" />
            <ColumnDefinition Width="30*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="3" BorderThickness="0,0,0,2" BorderBrush="Black">

            <barUserControl:TopAppBar BarHeader="Appointment Schedules"/>
        </Border>

        <barUserControl:TimeBlockSchedule x:Name="scheduleControl" Grid.Column="0" Grid.Row="1"></barUserControl:TimeBlockSchedule>
        <Border Grid.Column="1" Grid.Row="1" BorderBrush="Black" BorderThickness="1,0,2,1">


            <Grid Background="#4CBED8E6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="6*" />
                </Grid.RowDefinitions>



                <Border Grid.Row="0" BorderThickness="0,0,0,2" BorderBrush="Black">
                    <StackPanel  VerticalAlignment="Top">
                        <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly" Margin="10,0,0,0">
                            <Label FontSize="16" Content="View Patients Appointments By Date"/>
                        </Viewbox>
                        <DatePicker x:Name="patientAppointmentTimePicker" VerticalAlignment="Center" Margin="15,0,10,0" FontSize="16" SelectedDateChanged="PatientAppointmentTimePicker_OnSelectedDateChanged" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1">
                    <Viewbox  StretchDirection="DownOnly" Margin="0,10,0,0">
                        <Button x:Name="createAppointmentButton" Style="{StaticResource BlueButtonStyle}" FontSize="16" Padding="4,5,4,5" Background="#FFF1F1F1">View Appointment Information</Button>
                    </Viewbox>
                    <Viewbox  StretchDirection="DownOnly" Margin="0,40,0,0">
                        <Button x:Name="exitAppointmentButton" Style="{StaticResource BlueButtonStyle}" FontSize="16" Padding="4,5,4,5" Background="#FFE68181">Exit Patient Appointments</Button>
                    </Viewbox>
                </StackPanel>
            </Grid>

        </Border>

    </Grid>
</Window>