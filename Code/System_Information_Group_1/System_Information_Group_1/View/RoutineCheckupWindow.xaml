<Window x:Class="System_Information_Group_1.View.RoutineCheckupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:barUserControl="clr-namespace:System_Information_Group_1.View.UserControls"
        mc:Ignorable="d"
        Title="Routine Checkup Entry"
        MinHeight="720"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Grid Background="LightBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70*" />
            <ColumnDefinition Width="30*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                BorderThickness="0,0,0,2"
                BorderBrush="Black">
            <barUserControl:TopAppBar x:Name="topAppBarControl"
                                     BarHeader="Routine Checkup Entry" />
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                BorderBrush="Black"
                BorderThickness="0,0,2,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Patient Vitals &amp; Diagnosis"
                               FontSize="24"
                               Margin="0,0,0,15" />

                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <Label Content="Symptoms" FontSize="16" FontWeight="Bold"/>
                        <TextBox x:Name="symptomsTextBox"
                                 Text="{Binding Symptoms, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15"
                                 Height="80"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxLength="200"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Label Content="Systolic BP" FontSize="15" />
                            <TextBox x:Name="systolicTextBox"
                                     Text="{Binding SystolicBloodPressure, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15" Height="32" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <Label Content="Diastolic BP" FontSize="15" />
                            <TextBox x:Name="diastolicTextBox"
                                     Text="{Binding DiastolicBloodPressure, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15" Height="32" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <Label Content="Temp (°F)" FontSize="15" />
                            <TextBox x:Name="temperatureTextBox"
                                     Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15" Height="32" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <Label Content="Pulse" FontSize="15" />
                            <TextBox x:Name="pulseTextBox"
                                     Text="{Binding Pulse, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15" Height="32" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Label Content="Height (in)" FontSize="15" />
                            <TextBox x:Name="heightTextBox"
                                     Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15" Height="32" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <Label Content="Weight (lbs)" FontSize="15" />
                            <TextBox x:Name="weightTextBox"
                                     Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15" Height="32" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,0,0,15">
                        <Label Content="Initial Diagnosis" FontSize="16" FontWeight="Bold"/>
                        <TextBox x:Name="initialDiagnosisTextBox"
                                 Text="{Binding InitialDiagnosis, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15"
                                 Height="60"
                                 AcceptsReturn="True"
                                 MaxLength="200"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,10"/>

                        <Label Content="Final Diagnosis" FontSize="16" FontWeight="Bold"/>
                        <TextBox x:Name="finalDiagnosisTextBox"
                                 Text="{Binding FinalDiagnosis, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15"
                                 Height="60"
                                 AcceptsReturn="True"
                                 MaxLength="200"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Checkup Actions"
                       FontSize="24"
                       Margin="15,15,0,15" />

            <Border Grid.Row="1"
                    BorderBrush="Black"
                    BorderThickness="0,2,0,2"
                    Padding="15">

                <StackPanel>
                    <Button x:Name="submitButton"
                            Content="Submit Checkup"
                            FontSize="16"
                            Height="45"
                            Style="{StaticResource BlueButtonStyle}"
                            Background="#FFF1F1F1"
                            Click="SubmitButton_OnClick" />

                    <Button x:Name="orderTestButton"
                            Content="Order Test"
                            FontSize="16"
                            Height="45"
                            Margin="0,15,0,0"
                            Style="{StaticResource BlueButtonStyle}"
                            Background="#FFF1F1F1"
                            Click="OnOrderTestClick" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="15">
                <TextBlock Text="Test Results"
                           FontSize="20"
                           Margin="0,0,0,10" />
                <DataGrid x:Name="testsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Test"
                                            Binding="{Binding Name}"
                                            IsReadOnly="True"
                                            Width="*" />
                        <DataGridTextColumn Header="Low"
                                            Binding="{Binding LowValue}"
                                            IsReadOnly="True"
                                            Width="Auto" />
                        <DataGridTextColumn Header="High"
                                            Binding="{Binding HighValue}"
                                            IsReadOnly="True"
                                            Width="Auto" />
                        <DataGridTextColumn Header="Unit"
                                            Binding="{Binding MeasurementType}"
                                            IsReadOnly="True"
                                            Width="Auto" />
                        <DataGridTextColumn Header="Result"
                                            Binding="{Binding TestResult, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*" />
                        <DataGridCheckBoxColumn Header="Abnormal"
                                                Binding="{Binding IsAbnormal, UpdateSourceTrigger=PropertyChanged}"
                                                Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>