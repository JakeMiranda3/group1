<Window x:Class="System_Information_Group_1.View.PatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:barUserControl="clr-namespace:System_Information_Group_1.View.UserControls"
        mc:Ignorable="d"
        Title="Patient Management"
        MinHeight="720"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    
    <Grid Background="LightBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70*" />
            <ColumnDefinition Width="30*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                BorderThickness="0,0,0,2"
                BorderBrush="Black">

            <barUserControl:TopAppBar x:Name="TopAppBarControl" BarHeader="Patient Information"></barUserControl:TopAppBar>
            
            
        </Border>

        
        <Border Grid.Row="1"
                Grid.Column="0"
                BorderBrush="Black"
                BorderThickness="0,0,2,0">

            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Search Patients"
                           FontSize="24"
                           Margin="0,0,0,15" />

                <Border Grid.Row="1"
                        BorderBrush="Black"
                        BorderThickness="0,0,0,2"
                        Padding="0,0,0,15"
                        Margin="0,0,0,15">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Label Content="First Name" FontSize="16" />
                            <TextBox x:Name="firstNameTextBox"
                                     FontSize="16"
                                     Height="32" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <Label Content="Last Name" FontSize="16" />
                            <TextBox x:Name="lastNameTextBox"
                                     FontSize="16"
                                     Height="32" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <Label Content="Date of Birth" FontSize="16" />
                            <DatePicker x:Name="dateOfBirthPicker"
                                        FontSize="16"
                                        Height="32" />
                        </StackPanel>

                        <Button x:Name="searchButton"
                                Grid.Column="3"
                                Content="Search"
                                Width="100"
                                Height="35"
                                VerticalAlignment="Top"
                                Style="{StaticResource BlueButtonStyle}"
                                Background="#FFF1F1F1"
                                Click="SearchButton_OnClick" Margin="0,28,0,0" />
                    </Grid>
                </Border>

                <DataGrid x:Name="patientDataGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          FontSize="15"
                          Background="White"
                          BorderBrush="Black"
                          BorderThickness="1"
                          RowHeight="35"
                          ColumnHeaderHeight="38">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Patient ID"
                                            Binding="{Binding PatientId}"
                                            Width="*" />

                        <DataGridTextColumn Header="First Name"
                                            Binding="{Binding Person.FirstName}"
                                            Width="*" />

                        <DataGridTextColumn Header="Last Name"
                                            Binding="{Binding Person.LastName}"
                                            Width="*" />

                        <DataGridTextColumn Header="DOB"
                                            Binding="{Binding Person.DateOfBirth, StringFormat=d}"
                                            Width="*" />

                        <DataGridTextColumn Header="Phone"
                                            Binding="{Binding Person.ContactPhoneNumber}"
                                            Width="*" />

                        <DataGridCheckBoxColumn Header="Active"
                                                Binding="{Binding IsActive}"
                                                Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Patient Navigation"
                       FontSize="24"
                       Margin="15,15,0,15" />


            <Border Grid.Row="1"
                    BorderBrush="Black"
                    BorderThickness="0,2,0,2"
                    Padding="15">

                <Border.Resources>
                    <Style x:Key="SelectedPatientButtonStyle"
                           TargetType="Button"
                           BasedOn="{StaticResource BlueButtonStyle}">

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=patientDataGrid}"
                                         Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>

                <StackPanel>
                    <Button x:Name="makePatientButton"
                            Content="Make Patient"
                            FontSize="16"
                            Height="45"
                            Style="{StaticResource BlueButtonStyle}"
                            Background="#FFF1F1F1"
                            Click="MakePatientButton_OnClick" />

                    <Button x:Name="viewPatientButton"
                            Content="View Full Info"
                            FontSize="16"
                            Height="45"
                            Margin="0,15,0,0"
                            Style="{StaticResource SelectedPatientButtonStyle}"
                            Background="#FFF1F1F1"
                            Click="ViewPatientButton_OnClick" />
                    <Button x:Name="createAppointmentButton"
                            Content="Schedule Patient Appointment"
                            FontSize="16"
                            Height="45"
                            Margin="0,15,0,0"
                            Style="{StaticResource SelectedPatientButtonStyle}"
                            Background="#FFF1F1F1"
                            Click="CreateAppointmentButton_OnClick" />
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>