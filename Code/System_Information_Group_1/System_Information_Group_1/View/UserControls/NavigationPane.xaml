<UserControl x:Class="System_Information_Group_1.View.UserControls.NavigationPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <Grid>
        <Popup x:Name="partPopup"
               StaysOpen="False"
               AllowsTransparency="True"
               Placement="Relative"
               Focusable="False"
               HorizontalOffset="0"
               VerticalOffset="0">
            <Border x:Name="rootBorder"
                    Width="300"
                    Background="#FF2B579A"
                    BorderBrush="Black"
                    BorderThickness="0,0,2,0"
                    SnapsToDevicePixels="True">
                
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/> 

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/> 
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="closeButton"
                                Content="X"
                                Width="30"
                                Height="30"
                                Margin="0,0,0,10"
                                Click="CloseButton_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="Navigation"
                               FontSize="20"
                               Foreground="White"
                               Margin="0,0,0,10" />

                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,0">
                        <Button Content="Patients" Height="40" Margin="0,5,0,0" HorizontalAlignment="Stretch" Click="onPatientsButtonClicked"/>
                        <Button Content="Nurses" Height="40" Margin="0,5,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Row 3 is the flexible spacer -->

                    <Button Grid.Row="4"
                            Content="Logout"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            Margin="0,5,0,0"
                            Click="onLogoutClicked"
                            />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
