<UserControl Style="{DynamicResource CardStateStyle}" x:Class="System_Information_Group_1.View.UserControls.TimeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:System_Information_Group_1.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">
    
    
    <UserControl.Resources>
        <Style x:Key="TimeCardLabelStyle" TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Label}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardStateStyle" TargetType="{x:Type local:TimeCard}">
            <Setter Property="Background" Value="#FFA5D7A7"/>
            <Setter Property="IsEnabled" Value="True"/>

            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding State, RelativeSource={RelativeSource Self}}"
                    Value="{x:Static local:TimeCardState.Available}">

                    <Setter Property="Background" Value="#FFFFFFFB"/>

                </DataTrigger>
                <DataTrigger
                    Binding="{Binding State, RelativeSource={RelativeSource Self}}"
                    Value="{x:Static local:TimeCardState.PendingLabs}">

                    <Setter Property="Background" Value="#FFFFF082"/>

                </DataTrigger>
                <DataTrigger
                    Binding="{Binding State, RelativeSource={RelativeSource Self}}"
                    Value="{x:Static local:TimeCardState.PastDeadline}">

                    <Setter Property="Background" Value="#FFFFB3A7"/>

                </DataTrigger>
                <DataTrigger
                    Binding="{Binding State, RelativeSource={RelativeSource Self}}"
                    Value="{x:Static local:TimeCardState.Finalized}">
                    <Setter Property="Background" Value="#FFDC7A1C"/>
                    <Setter Property="IsEnabled" Value="False"/>

                </DataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding State, RelativeSource={RelativeSource self}}" Value="{x:Static local:TimeCardState.BeforeDeadline}"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FF66BB6A"/>
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition
                            Binding="{Binding State, RelativeSource={RelativeSource Self}}"
                            Value="{x:Static local:TimeCardState.Available}"/>
                        <Condition
                            Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                            Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFD5ECFF"/>
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition
                            Binding="{Binding State, RelativeSource={RelativeSource Self}}"
                            Value="{x:Static local:TimeCardState.PendingLabs}"/>
                        <Condition
                            Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                            Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFFFD54F"/>
                </MultiDataTrigger>

            </Style.Triggers>
        </Style>




    </UserControl.Resources>
    <Border BorderThickness="1,1,1,1" BorderBrush="Black" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:TimeCard}}}">

        <Grid>
            <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                    <ColumnDefinition Width="4*"></ColumnDefinition>
                    <ColumnDefinition Width="4*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderThickness="0,1,2,1" BorderBrush="Black">
                    <Viewbox StretchDirection="DownOnly" Stretch="Fill" >
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,5,0">
                        <Label Style="{StaticResource TimeCardLabelStyle}" x:Name="dateLabel" FontSize="16"></Label>
                        <Label Style="{StaticResource TimeCardLabelStyle}" x:Name="timeLabel" HorizontalAlignment="Center" FontSize="16"></Label>
                        </StackPanel>
                    </Viewbox>
                </Border>
                <Border Grid.Column="1" BorderThickness="0,1,2,1" BorderBrush="Black">
                    <Viewbox StretchDirection="DownOnly" Stretch="Fill" >
                    <Label Style="{StaticResource TimeCardLabelStyle}" x:Name="doctorLabel" FontSize="16"></Label>
                    </Viewbox>
                </Border>
                <Border Grid.Column="2" BorderThickness="0,1,2,1" BorderBrush="Black">
                    <Viewbox StretchDirection="DownOnly" Stretch="Fill" >
                        <StackPanel Margin="5,0,5,0">
                            <Label Style="{StaticResource TimeCardLabelStyle}" x:Name="patientNameLabel" FontSize="16"></Label>
                        <Label Style="{StaticResource TimeCardLabelStyle}" x:Name="patientPhoneLabel" HorizontalAlignment="Center" FontSize="16"></Label>
                        </StackPanel>
                    </Viewbox>
                </Border>
            </Grid>
    </Border>
</UserControl>
