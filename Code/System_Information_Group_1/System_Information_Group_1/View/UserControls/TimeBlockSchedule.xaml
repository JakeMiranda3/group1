<UserControl x:Class="System_Information_Group_1.View.UserControls.TimeBlockSchedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:System_Information_Group_1.View.UserControls"
             xmlns:cardControl="clr-namespace:System_Information_Group_1.View.UserControls"

             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FFDAECED">

        <Grid.RowDefinitions>
            <RowDefinition Height="90*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
        </Grid.RowDefinitions>
        <ListBox Background="{x:Null}" BorderBrush="#FF434446">
        </ListBox>
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Style="{StaticResource BlueButtonStyle}"  Width="100" Height="30" Margin="0,0,10,0" Background="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                Previous Day
            </Button>
            <Button Style="{StaticResource BlueButtonStyle}" Width="100" Height="30" Margin="0,0,10,0" Background="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                Next Day
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
