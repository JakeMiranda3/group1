<UserControl x:Class="System_Information_Group_1.View.UserControls.TimeBlockSchedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:System_Information_Group_1.View.UserControls"
             xmlns:cardControl="clr-namespace:System_Information_Group_1.View.UserControls"

             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FFDAECED">

        <Grid.RowDefinitions>
            <RowDefinition Height="8*"></RowDefinition>
            <RowDefinition Height="8*"></RowDefinition>
            <RowDefinition Height="8*"></RowDefinition>
            <RowDefinition Height="8*"></RowDefinition>
            <RowDefinition Height="8*"></RowDefinition>
            <RowDefinition Height="8*"></RowDefinition>
            <RowDefinition Height="8*"></RowDefinition>
            <RowDefinition Height="8*"></RowDefinition>
            <RowDefinition Height="8*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
        </Grid.RowDefinitions>
        <cardControl:TimeCard Grid.Row="1"/>
        <cardControl:TimeCard Grid.Row="2"/>
        <cardControl:TimeCard Grid.Row="3"/>
        <cardControl:TimeCard Grid.Row="4"/>
        <cardControl:TimeCard Grid.Row="5"/>
        <StackPanel Orientation="Horizontal" Grid.Row="9" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Width="50" Height="30" Margin="0,0,5,0" Background="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                Back
            </Button>
            <Button Width="50" Height="30" Margin="0,0,5,0" Background="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                Next
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
