<UserControl x:Class="System_Information_Group_1.View.UserControls.TimeBlockSchedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:System_Information_Group_1.View.UserControls"
             xmlns:cardControl="clr-namespace:System_Information_Group_1.View.UserControls"

             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="ScheduleListItemTemplate"
               TargetType="ListBoxItem">

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2,5,2,5">

                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>

                        </Border>

                        <ControlTemplate.Triggers>


                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{StaticResource SecondaryColorBrush}"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource PrimaryBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="90*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderThickness="2,0,2,0" BorderBrush="Black">
                <Viewbox>
                    <Label>Doctor</Label>
                </Viewbox>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}">
                <Viewbox>
                    <Label>Patient Name : Phone</Label>
                </Viewbox>
            </Border>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                <Viewbox>
                    <Label>Date</Label>
                </Viewbox>
            </Border>
        </Grid>
        <ListBox Grid.Row="1" ItemContainerStyle="{StaticResource ScheduleListItemTemplate}" x:Name="scheduleListBox" Background="{x:Null}" BorderBrush="#FF434446" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        </ListBox>
    </Grid>
</UserControl>
