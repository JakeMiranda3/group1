<UserControl x:Class="System_Information_Group_1.View.UserControls.TopAppBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:System_Information_Group_1.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="1200">
    <Grid Background="White" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="25*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="30*"/>
        </Grid.ColumnDefinitions>
        <Viewbox Grid.Column="3" HorizontalAlignment="Right" StretchDirection="DownOnly">
            <TextBlock  Margin="0,0,10,0" TextWrapping="Wrap" Text="ROLE FIRSTNAME LASTNAME" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="18"/>
        </Viewbox>
        <Viewbox Grid.Column="1" StretchDirection="DownOnly">
            <TextBlock  Margin="0,0,0,0" TextWrapping="Wrap" Text="Appointment Schedules" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24"/>

        </Viewbox>
        <Viewbox Grid.Column="0" Margin="10,10,10,10" HorizontalAlignment="Left">
            <Button  Background="{x:Null}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,0,0,0" Width="50" Height="50" BorderBrush="Black" BorderThickness="3,3,3,3">

                <Grid Margin="5,0,5,0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="4*"/>
                    </Grid.RowDefinitions>

                    <Rectangle Grid.Row="1" Fill="Black"></Rectangle>
                    <Rectangle Grid.Row="3" Fill="Black"></Rectangle>
                    <Rectangle Grid.Row="5" Fill="Black"></Rectangle>

                </Grid>
            </Button>
        </Viewbox>


    </Grid>
</UserControl>
