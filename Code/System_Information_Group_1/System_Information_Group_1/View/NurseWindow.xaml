<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:System_Information_Group_1.View"
        xmlns:UserControls="clr-namespace:System_Information_Group_1.View.UserControls"
        x:Class="System_Information_Group_1.View.NurseWindow"
        mc:Ignorable="d"
        Title="NurseWindow"
        MinHeight="720"
        MinWidth="1280">
    <Grid>


        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <UserControls:TopAppBar Grid.Row="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                BarHeader="Search Nurses"
                                />


        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="24,12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    SnapsToDevicePixels="True"
                    >

            <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                <TextBlock Text="First Name" Margin="4,0"/>
                <TextBox x:Name="FirstNameTextBox" Width="160"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                <TextBlock Text="Last Name" Margin="4,0"/>
                <TextBox x:Name="LastNameTextBox" Width="160"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                <TextBlock Text="Date of Birth" Margin="4,0"/>
                <DatePicker x:Name="DateOfBirthPicker" Width="160"/>
            </StackPanel>

            <Button x:Name="SearchButton"
                    Content="Search"
                    Width="100"
                    VerticalAlignment="Bottom"
                    Click="SearchButton_Click"/>

        </StackPanel>


        <DataGrid Grid.Row="2"
                  x:Name="NurseDataGrid"
                  Margin="24,24,410,24"
                  AutoGenerateColumns="True"
                  IsReadOnly="False"
                  FontFamily="Segoe UI"/>
        <Button x:Name="EditNurseButton" Content="Edit" HorizontalAlignment="Left" Margin="973,58,0,0" Grid.Row="2" VerticalAlignment="Top" Height="32" Width="149" FontFamily="Arial Black" Click="EditButton_Click"/>

    </Grid>
</Window>
